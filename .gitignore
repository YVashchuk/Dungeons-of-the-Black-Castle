# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Node (if ever used)
node_modules/
npm-debug.log*

# Python (if ever used for parsing)
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/

# Local/temp
*.log
*.tmp
tmp/
temp/

# Save files from users (shouldn't be in repo)
*-save.json
podzch-save.json
.local_saves/

# Build artifacts (optional - uncomment to skip)
# dist/

# Handoff drafts for external AI sessions (local working notes, not for git)
_handoff/

# Secrets (safety)
.env
.env.local
secrets.json

# Commit message drafts (used with git commit -F)
_commit_msg.txt
_commit_msg_*.txt

# Per-cycle working artifacts (throwaway verification scripts + commit-msg drafts).
# The audit BRIEFS/REPORTS (*.md) under audit_cycles/ are tracked; these are not.
audit_cycles/**/scripts/
audit_cycles/**/*_commit_msg.txt
tests/smoke/out/
tests/smoke/node_modules/
tests/smoke/package.json
tests/smoke/package-lock.json
